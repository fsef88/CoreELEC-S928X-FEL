From: SamuriHL <samurihl@msn.com>
Subject: [PATCH] BD-J: a PRESENT xlet reads NOT_LOADED until an application starts it

BDJLoader initialises every PRESENT xlet as soon as a title starts, and
the xlet's AppProxy then reports PAUSED. A player does not load a
PRESENT xlet until an application starts it. BD+ Handshake xlets rely on
that: Turbo 3D's com.macrovision.bdplus.Handshake.exitToXlet() starts the
disc's menu xlet (StandardMenuXlet) only if its proxy reports NOT_LOADED,
and otherwise logs "Application state wasn't NOT_LOADED" and stops. The
loader's init ran on the menu xlet's own thread in parallel, so the disc
started only when the Handshake won the race - most starts hung on a
black screen with the menu xlet's worker waiting for a start that never
came.

Keep the early init, but mask it: a fresh proxy the loader initialises
shows applications the state their own commands produced, as if the early
init had not happened. Each application command is decided on the proxy's
command thread when it runs, against that shown state, with the stock
semantics of its do*() method: load() on NOT_LOADED succeeds (LOADED shown;
the loader already loaded the class), init() reports the LOADED/NOT_LOADED
->PAUSED the loader's init already did (or its failure), pause() and
resume() of a xlet never started by an application fail without acting,
stop() reports from the shown state (destroying the initialised xlet, or,
if the loader's init failed, stopping it as stock stops an uninitialised
one), and start() acts for real with the shown state as its from-state.
The xlet's own notifyPaused()/notifyDestroyed() while masked (e.g. from
initXlet during the loader's init) are held and replayed where stock
would have queued them - behind what was queued when the application's
init/start ran - or dropped, together with any the xlet sends during a
masked stop, if it is stopped first. While a masked start runs, getState()
still reads the shown state. The loader's init sends no state-change event. The
mask is set on the proxy's command thread just before that init runs, so
an application command queued ahead of it runs unmasked, as stock, and a
proxy kept from the previous title (not NOT_LOADED) is left alone.

Present since "Only autostart when requested" (2013); unchanged in
libbluray 1.5.1 and master.

--- a/src/libbluray/bdj/java/org/videolan/BDJAppProxy.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJAppProxy.java
@@ -60,7 +60,27 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public int getState() {
-        return state;
+        /* A PRESENT xlet that only the loader has initialised (initPresent())
+         * is still NOT_LOADED to the disc: a player loads it only when an
+         * application asks. BD+ Handshake xlets (Turbo 3D) start the disc's
+         * menu xlet only while it reports NOT_LOADED, and the early init raced
+         * them. While masked, applications see the state their own commands
+         * produced, as if the early init had not happened. */
+        if (masked)
+            return shown;
+        int s = state;
+        /* the command thread may have masked (and started loading) since */
+        return masked ? shown : s;
+    }
+
+    /* loader only: initialise a PRESENT xlet ahead of its start, invisibly */
+    protected void initPresent() {
+        AppCommand cmd = new AppCommand(AppCommand.CMD_INIT, null);
+        cmd.setLoaderInit();
+        synchronized (cmds) {
+            cmds.addLast(cmd);
+            cmds.notifyAll();
+        }
     }
 
     public void load() {
@@ -126,6 +146,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
 
     protected void notifyDestroyed() {
         AppCommand cmd = new AppCommand(AppCommand.CMD_NOTIFY_DESTROYED, null);
+        tagMaskEpoch(cmd);
         synchronized (cmds) {
             cmds.addLast(cmd);
             cmds.notifyAll();
@@ -134,6 +155,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
 
     protected void notifyPaused() {
         AppCommand cmd = new AppCommand(AppCommand.CMD_NOTIFY_PAUSED, null);
+        tagMaskEpoch(cmd);
         synchronized (cmds) {
             cmds.addLast(cmd);
             cmds.notifyAll();
@@ -347,9 +369,54 @@ class BDJAppProxy implements DVBJProxy, Runnable {
             }
             if (cmd == null)
                 return;
-            int fromState = state;
+            if (cmd.isLoaderInit()) {
+                /* the loader's early init: no event. A proxy that was not
+                 * fresh (not masked), or that an application command queued
+                 * ahead of this one has already moved on, is left alone. */
+                /* The mask is set here, on the command thread, just before the
+                 * init: an application command queued ahead of it ran
+                 * unmasked, as stock, and a proxy kept from the previous
+                 * title (not NOT_LOADED) is left alone. */
+                if (!masked && state == NOT_LOADED) {
+                    shown = NOT_LOADED;
+                    maskEpoch++;            /* before masked: see tagMaskEpoch() */
+                    masked = true;
+                    doInit();
+                }
+                cmd.release();
+                continue;
+            }
+            /* The xlet's own notifications while masked (e.g. notifyPaused()
+             * from initXlet during the loader's init) are held: stock would
+             * deliver them after the application's init/start ran initXlet. */
+            if (cmd.getCommand() == AppCommand.CMD_NOTIFY_PAUSED ||
+                cmd.getCommand() == AppCommand.CMD_NOTIFY_DESTROYED) {
+                if (masked) {
+                    heldNotify.addLast(cmd);
+                    continue;
+                }
+                /* sent while a mask was on that ended with the xlet stopped
+                 * (e.g. from destroyXlet in a masked stop): stock never ran
+                 * the xlet, so there is nothing to notify */
+                if (cmd.getMaskEpoch() >= 0 && cmd.getMaskEpoch() == droppedEpoch) {
+                    cmd.release();
+                    continue;
+                }
+            }
+            maskedFrom = -1;
+            if (masked && runMasked(cmd))
+                continue;
+            int fromState = (maskedFrom >= 0) ? maskedFrom : state;
             int toState;
             boolean ret;
+            /* where stock would have queued a notification initXlet sends
+             * during this start: behind what is already queued now */
+            int replayAt = -1;
+            if (maskedFrom >= 0 && cmd.getCommand() == AppCommand.CMD_START) {
+                synchronized (cmds) {
+                    replayAt = cmds.size();
+                }
+            }
             switch (cmd.getCommand()) {
             case AppCommand.CMD_LOAD:
                 toState = LOADED;
@@ -389,16 +456,135 @@ class BDJAppProxy implements DVBJProxy, Runnable {
             default:
                 return;
             }
+            /* acted for real: nothing is masked any more (this also drops a
+             * mask initPresent() set while this command was already running) */
+            masked = false;
             notifyListeners(fromState, toState, !ret);
             cmd.release();
             if (state == DESTROYED)
                 state = NOT_LOADED;
+            if (maskedFrom >= 0)
+                endHeldNotify(cmd.getCommand() == AppCommand.CMD_START, replayAt);
+        }
+    }
+
+    /* notifications record the mask they were sent under */
+    private void tagMaskEpoch(AppCommand cmd) {
+        boolean m = masked;             /* masked first: maskEpoch is bumped before it */
+        cmd.setMaskEpoch(m ? maskEpoch : -1);
+    }
+
+    /* After the mask ends: replay the xlet's held notifications right after
+     * the init/start that ran initXlet in stock, or drop them when the xlet
+     * never got that far (a failed load, a stop). */
+    private void endHeldNotify(boolean replay, int at) {
+        if (masked)
+            return;
+        if (!replay) {
+            droppedEpoch = maskEpoch;
+            while (!heldNotify.isEmpty())
+                ((AppCommand)heldNotify.removeFirst()).release();
+            return;
+        }
+        if (heldNotify.isEmpty())
+            return;
+        synchronized (cmds) {
+            for (int i = 0; !heldNotify.isEmpty(); i++) {
+                Object c = heldNotify.removeFirst();
+                if (at < 0 || at + i > cmds.size())
+                    cmds.addLast(c);
+                else
+                    cmds.add(at + i, c);
+            }
+            cmds.notifyAll();
         }
     }
 
+    /* A command on a masked xlet, answered from the state applications were
+     * shown with stock semantics (see the do*() methods): the loader's init
+     * already did the work a load or init would. Commands that move the xlet
+     * on for real take the ordinary path with the shown state as their
+     * from-state, and unmask it once done. Returns true when the command was
+     * answered here. */
+    private boolean runMasked(AppCommand cmd) {
+        int from = shown;
+        int to;
+        boolean ret;
+        switch (cmd.getCommand()) {
+        case AppCommand.CMD_LOAD:
+            /* the loader's init loaded the class (xlet set) or failed to */
+            to = LOADED;
+            if (shown == LOADED) {
+                ret = false;                /* stock: already loaded */
+            } else if (xlet != null) {
+                shown = LOADED;
+                ret = true;
+            } else {
+                masked = false;             /* the load failed: INVALID */
+                ret = false;
+            }
+            notifyListeners(from, to, !ret);
+            cmd.release();
+            endHeldNotify(false, -1);
+            return true;
+        case AppCommand.CMD_INIT:
+            /* done by the loader's init, or failed there as it would here */
+            to = PAUSED;
+            ret = (state == PAUSED);
+            /* stock queues initXlet's notifications behind what is queued
+             * now - ahead of anything a listener queues on this event */
+            int at;
+            synchronized (cmds) {
+                at = cmds.size();
+            }
+            masked = false;
+            notifyListeners(from, to, !ret);
+            cmd.release();
+            endHeldNotify(true, at);
+            return true;
+        case AppCommand.CMD_STOP:
+            to = DESTROYED;
+            if (state == PAUSED) {
+                maskedFrom = from;          /* destroy the initialised xlet */
+                return false;
+            }
+            /* never initialised: stock stops a NOT_LOADED/LOADED xlet
+             * without calling it */
+            xlet = null;
+            state = NOT_LOADED;
+            masked = false;
+            notifyListeners(from, to, false);
+            cmd.release();
+            endHeldNotify(false, -1);
+            return true;
+        case AppCommand.CMD_PAUSE:
+            to = PAUSED;                    /* never started: fails */
+            ret = false;
+            break;
+        case AppCommand.CMD_RESUME:
+            to = STARTED;                   /* never paused by an application: fails */
+            ret = false;
+            break;
+        default:
+            /* start acts for real; the mask stays on until it has */
+            maskedFrom = from;
+            return false;
+        }
+        notifyListeners(from, to, !ret);
+        cmd.release();
+        return true;
+    }
+
     private BDJXletContext context;
     private Xlet xlet;
-    private int state;
+    private volatile int state;
+    /* the early-init mask: written only by the command thread */
+    private volatile boolean masked = false;
+    private volatile int shown = NOT_LOADED;
+    private int maskedFrom = -1; /* command thread only */
+    private LinkedList heldNotify = new LinkedList(); /* command thread only */
+    private volatile int maskEpoch = 0; /* written by the command thread */
+    private int droppedEpoch = -1; /* command thread only */
     private LinkedList listeners = new LinkedList();
     private LinkedList cmds = new LinkedList();
     private Thread thread;
@@ -464,8 +650,26 @@ class BDJAppProxy implements DVBJProxy, Runnable {
         public static final int CMD_NOTIFY_DESTROYED = 6;
         public static final int CMD_NOTIFY_PAUSED = 7;
 
+        public void setLoaderInit() {
+            loaderInit = true;
+        }
+
+        public boolean isLoaderInit() {
+            return loaderInit;
+        }
+
+        public void setMaskEpoch(int epoch) {
+            maskEpoch = epoch;
+        }
+
+        public int getMaskEpoch() {
+            return maskEpoch;
+        }
+
         private int cmd;
         private Object arg;
         private boolean done = false;
+        private boolean loaderInit = false;
+        private int maskEpoch = -1;
     }
 }
--- a/src/libbluray/bdj/java/org/videolan/BDJLoader.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJLoader.java
@@ -297,7 +297,7 @@ public class BDJLoader {
                     proxys[i].start();
                 } else if (code == AppEntry.PRESENT) {
                     logger.info("Init xlet " + i + ": " + appTable[i].getInitialClass());
-                    proxys[i].init();
+                    proxys[i].initPresent();
                 } else {
                     logger.info("Unsupported xlet code (" +code+") xlet " + i + ": " + appTable[i].getInitialClass());
                 }
